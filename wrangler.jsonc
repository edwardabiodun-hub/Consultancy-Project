{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "runrate-advisory",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.runrategroup.com"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runrate-advisory-production",
      "database_id": "b6f4f578-0064-4c60-9928-c28adbaf4847",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
